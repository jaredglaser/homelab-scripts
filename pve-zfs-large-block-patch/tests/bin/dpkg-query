#!/usr/bin/env bash
# Fake dpkg-query for tests. The script branches on this output, so unlike the
# fixed-behaviour stubs in sshl/tests/bin this one is driven by the environment.
#   FAKE_DPKG_QUERY_ARGS - file that receives the argument list, one per line
#   FAKE_PKG_RAW    - emit this verbatim on stdout instead of a normal answer
#   FAKE_PKG_STDERR - also print this on stderr, as dpkg does for warnings
#   FAKE_PKG_RC     - 1 means dpkg has no record of the package, 2+ means the query broke
#   FAKE_PKG_STATE  - the db:Status-Status value of a normal answer
printf '%s\n' "$@" >> "${FAKE_DPKG_QUERY_ARGS:-/dev/null}"
[[ -n "${FAKE_PKG_STDERR:-}" ]] && printf '%s\n' "$FAKE_PKG_STDERR" >&2

if [[ -n "${FAKE_PKG_RAW+set}" ]]; then
    printf '%s' "$FAKE_PKG_RAW"
    exit "${FAKE_PKG_RC:-0}"
fi

case "${FAKE_PKG_RC:-0}" in
    0) printf '%s\n' "${FAKE_PKG_STATE:-installed}" ;;
    1) echo "dpkg-query: no packages found matching ${*: -1}" >&2; exit 1 ;;
    *) echo "dpkg-query: error: unable to read database" >&2; exit "${FAKE_PKG_RC}" ;;
esac
