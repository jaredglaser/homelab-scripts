#!/usr/bin/env bash
# Failing grep for tests, linked in by with_stub. Root reads a chmod 000 file
# anyway, so a read error has to be faked. A call whose argument list contains
# FAKE_GREP_FAIL_MATCH exits 2 like a read error, any other call runs the real
# grep. With FAKE_GREP_FAIL_MATCH unset every call fails.
if [[ -n "${FAKE_GREP_FAIL_MATCH:-}" && "$*" != *"$FAKE_GREP_FAIL_MATCH"* ]]; then
    exec "${REAL_GREP:?}" "$@"
fi
echo "grep: ${*: -1}: Input/output error" >&2
exit 2
