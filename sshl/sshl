#!/usr/bin/env bash
set -euo pipefail

rebuild=false
for arg in "$@"; do
    case "$arg" in
        -R|--rebuild) rebuild=true ;;
        -h|--help)
            cat <<EOF
Usage: $(basename "$0") [options]
  -R, --rebuild    Nuke the tmux server and rebuild windows from cache.
  -h, --help       Show this help.

With no flags: bootstrap a new session (scan + filter on first run) or
attach a grouped view to the existing session.

Inside the session, use these key bindings to manage hosts:
  prefix S    Scan + add or remove hosts (popup)
  prefix O    Reorder windows (popup)
  prefix I    Show ignored hosts to un-ignore (popup)
  prefix H    Fuzzy jump to a host
EOF
            exit 0 ;;
        *) echo "Unknown argument: $arg. Run '$(basename "$0") --help' for the options." >&2; exit 1 ;;
    esac
done

# readlink -f so a symlink to sshl (say in ~/bin) still finds the library.
# shellcheck source=sshl/sshl-lib.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/sshl-lib.sh"

read_cache
read_ignored

built=false
if $rebuild; then
    if [[ ${#ips[@]} -eq 0 ]]; then
        echo "Error: no cache to rebuild from. Run sshl with no args to bootstrap." >&2
        exit 1
    fi
    build_session
    built=true
elif ! session_is_healthy; then
    if [[ ${#ips[@]} -eq 0 ]]; then
        # First-run bootstrap: scan, run filter popup in current shell,
        # then build session from selection.
        echo "No cached hosts. Running scan + filter to bootstrap..." >&2
        "${SSHL_DIR}/popup-scan.sh"
        read_cache
        # popup-scan.sh already printed why nothing was applied (cancelled,
        # nothing to show, no selection). Exit quietly rather than tacking
        # on a generic catch-all message.
        if [[ ${#ips[@]} -eq 0 ]]; then
            exit 0
        fi
        build_session
        built=true
    else
        build_session
        built=true
    fi
fi

# Warm host-info cache so window switches hit a fresh entry. The
# 24h TTL in host-info.sh means most calls return cached data,
# but cold-cache entries SSH the host and run apt-get update.
# Backgrounding lets the user attach without waiting on those.
echo "Warming host-info cache for ${#ips[@]} host(s) in background..." >&2
for ip in "${ips[@]}"; do
    u="${host_user[$ip]:-$default_user}"
    "$INFO_SCRIPT" "$u" "$ip" >/dev/null 2>&1 &
done
disown -a 2>/dev/null || true

# Reload conf so edits to homelab.tmux.conf take effect without --rebuild.
if ! conf_err="$("${TMUX_CMD[@]}" source-file "$TMUX_CONF" 2>&1)"; then
    echo "Warning: reloading $TMUX_CONF failed, so the session may run an older copy of it:" >&2
    printf '%s\n' "$conf_err" >&2
fi

# Refresh the global env each run, so the popup bindings find the
# scripts even on a session built by an older sshl.
session_exists && set_session_env

$built || echo "Reusing existing session '$session_name' (use --rebuild to recreate)." >&2

# Grouped attach: a new session sharing the base session's windows but
# with its own focus. destroy-unattached cleans up when the konsole
# closes.
attach_cmd=("${TMUX_CMD[@]}" new-session -t "=$session_name" \;
            set-option destroy-unattached on)

# The new terminal must not inherit TMUX: tmux refuses to start a client
# inside another one, and the terminal is a separate window anyway.
if command -v "${terminal_cmd[0]}" &>/dev/null; then
    # The terminal must not hold this script's output: a pipe or $(sshl)
    # would wait until the window closes, and its warnings would land in
    # the shell sshl was started from. A terminal that rejects its
    # arguments exits within moments, so wait briefly to report that.
    term_log="$(mktemp)"
    env -u TMUX -u TMUX_PANE "${terminal_cmd[@]}" "${terminal_exec[@]}" "${attach_cmd[@]}" \
        </dev/null >"$term_log" 2>&1 &
    term_pid=$!
    for _ in 1 2 3 4 5; do
        sleep 0.1
        kill -0 "$term_pid" 2>/dev/null && continue
        term_rc=0
        wait "$term_pid" || term_rc=$?
        if (( term_rc != 0 )); then
            cat "$term_log" >&2
            rm -f "$term_log"
            echo "Error: the terminal command '${terminal_cmd[*]}' exited with status $term_rc. Check the terminal= line in $CONFIG_FILE." >&2
            exit 1
        fi
        break
    done
    rm -f "$term_log"
    disown "$term_pid" 2>/dev/null || true
elif [[ -n "${TMUX:-}" ]]; then
    if [[ "${TMUX%%,*}" == "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$SOCKET" ]]; then
        echo "Terminal '${terminal_cmd[0]}' not found, and this shell already runs inside the sshl session." >&2
    else
        echo "Terminal '${terminal_cmd[0]}' not found, and this shell runs inside another tmux server." >&2
        echo "Run from a fresh terminal, or: tmux -L $SOCKET new-session -t '=$session_name'" >&2
    fi
else
    echo "Terminal '${terminal_cmd[0]}' not found, so attaching in this shell." >&2
    "${attach_cmd[@]}"
fi
