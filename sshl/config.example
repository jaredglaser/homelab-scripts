# sshl config
#
# One key=value per line. A # starts a comment at the start of a line or
# after whitespace, so a # inside a value is kept.

# Subnet to scan for live hosts, in CIDR notation such as 192.168.1.0/24.
# sshl will not run until this is set.
subnet=

# Tmux session name. No '.' or ':'.
session_name=homelab

# Terminal emulator to launch (KDE default). It is run as
# `<terminal> -e tmux ...`, the form konsole, xterm, alacritty, kitty, tilix
# and foot accept. gnome-terminal gets `--` and xfce4-terminal gets `-x`
# in place of -e. For a terminal that needs another option, end the value
# with it (-e, -x or --) and sshl adds nothing.
# Arguments are allowed, e.g. terminal=konsole --profile homelab
# xterm's default font lacks the border and status glyphs, so give it one:
# terminal=xterm -fa Monospace -fs 11
terminal=konsole

# Default SSH username (used when no per-host override)
default_user=root

# Default commands run in each window.
# Substitutions: {ip} {user} {hostname}
# NOTE: the right pane must SSH too. A bare `htop` would run locally.
# `ssh -t` allocates a pseudo-TTY which interactive TUIs like htop need.
left_cmd=ssh {user}@{ip}
right_cmd=ssh -t {user}@{ip} htop

# Pane layout applied to each host window.
# Options: even-horizontal | even-vertical | main-horizontal | main-vertical | tiled
layout=even-horizontal

# Per-host overrides (optional). Keys:
#   host.<ip>.user       override SSH username
#   host.<ip>.name       override tab name (otherwise the host's own
#                        `hostname -s` over ssh, then reverse DNS, then the IP)
#   host.<ip>.left_cmd   override left-pane command for this host
#   host.<ip>.right_cmd  override right-pane command for this host
#
# Examples:
# host.192.168.1.10.user=admin
# host.192.168.1.10.name=webserver
# host.192.168.1.20.right_cmd=ssh -t {user}@{ip} btop
